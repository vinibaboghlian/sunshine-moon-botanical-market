rules_version = '2';

// ===============================================================
// Assumed Data Model — Sunshine Moon Botanical Catalog
// ===============================================================
//
// Collection: products
// Document ID: {productId}
// Fields:
//   - name: string (required, 1..200 chars) - Product display name
//   - price: number (required, >= 0) - Product price in BRL
//   - category: string (required, 1..100 chars) - Category identifier
//   - is_active: bool (required) - Whether product is visible in catalog
//   - id: string (optional, 1..100 chars) - Client/catalog ID
//   - slug: string (optional, 1..200 chars) - URL slug
//   - description: string | null (optional, <= 5000 chars) - Product description
//   - sensory_notes: string | null (optional, <= 1000 chars) - Sensory notes
//   - benefits: list (optional, <= 30 items) - List of benefit strings
//   - image: string | null (optional, <= 2000 chars) - Primary image path/URL
//   - image_url: string | null (optional, <= 2000 chars) - Uploaded image URL
//   - stock_quantity: number (optional, >= 0) - Available stock count
//   - weight_grams: number (optional, >= 0) - Product weight in grams
//   - package_width_cm: number (optional, >= 0) - Package width in cm
//   - package_height_cm: number (optional, >= 0) - Package height in cm
//   - package_depth_cm: number (optional, >= 0) - Package depth in cm
//   - createdAt: timestamp (optional, immutable on update) - Creation timestamp
//   - updatedAt: timestamp (optional) - Last update timestamp
//
// Collection: categories
// Document ID: {categoryId}
// Fields:
//   - id: string (required, 1..100 chars) - Category identifier
//   - label: string (required, 1..100 chars) - Category display label
//   - createdAt: timestamp (optional, immutable on update) - Creation timestamp
//   - updatedAt: timestamp (optional) - Last update timestamp
//
// ===============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Helper Functions
    // ===============================================================

    // Check if the user is authenticated (admin-only in this app, sign-up disabled)
    function isAuthenticated() {
      return request.auth != null;
    }

    // Check if user owns the resource
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Verify UID hasn't been tampered with on create
    function uidUnchanged() {
      return !('uid' in request.resource.data) ||
        request.resource.data.uid == request.auth.uid;
    }

    // Ensure uid field is not modified on update
    function uidNotModified() {
      return !('uid' in request.resource.data) ||
        request.resource.data.uid == resource.data.uid;
    }

    // Validate required fields exist
    function hasRequiredFields(fields) {
      return request.resource.data.keys().hasAll(fields);
    }

    // Validate that the document contains only the allowed fields
    function hasOnlyAllowedFields(fields) {
      return request.resource.data.keys().hasOnly(fields);
    }

    // Validate required string length
    function validStringLength(field, minLen, maxLen) {
      return request.resource.data[field] is string &&
        request.resource.data[field].size() >= minLen &&
        request.resource.data[field].size() <= maxLen;
    }

    // Validate optional string (if present, must be string within length or null)
    function isValidOptionalStringOrNull(field, maxLen) {
      return !(field in request.resource.data) ||
        request.resource.data[field] == null ||
        (request.resource.data[field] is string &&
         request.resource.data[field].size() <= maxLen);
    }

    // Validate non-negative number
    function isNonNegativeNumber(field) {
      return request.resource.data[field] is number &&
        request.resource.data[field] >= 0;
    }

    // Validate optional non-negative number
    function isValidOptionalNonNegativeNumber(field) {
      return !(field in request.resource.data) ||
        (request.resource.data[field] is number &&
         request.resource.data[field] >= 0);
    }

    // Validate optional list with size limit
    function isValidOptionalList(field, maxSize) {
      return !(field in request.resource.data) ||
        (request.resource.data[field] is list &&
         request.resource.data[field].size() <= maxSize);
    }

    // Validate optional timestamp
    function isValidOptionalTimestamp(field) {
      return !(field in request.resource.data) ||
        request.resource.data[field] is timestamp;
    }

    // Protect createdAt from modification on update if it already exists
    function immutableCreatedAtUnchanged() {
      return !('createdAt' in resource.data) ||
        request.resource.data.createdAt == resource.data.createdAt;
    }

    // ===============================================================
    // Domain Validators (Called in BOTH create and update)
    // ===============================================================

    function isValidProduct(data) {
      let allowedFields = [
        'name', 'price', 'category', 'is_active',
        'id', 'slug', 'description', 'sensory_notes', 'benefits',
        'image', 'image_url', 'stock_quantity', 'weight_grams',
        'package_width_cm', 'package_height_cm', 'package_depth_cm',
        'createdAt', 'updatedAt'
      ];
      return hasRequiredFields(['name', 'price', 'category', 'is_active']) &&
        hasOnlyAllowedFields(allowedFields) &&
        validStringLength('name', 1, 200) &&
        isNonNegativeNumber('price') &&
        validStringLength('category', 1, 100) &&
        data.is_active is bool &&
        isValidOptionalStringOrNull('id', 100) &&
        isValidOptionalStringOrNull('slug', 200) &&
        isValidOptionalStringOrNull('description', 5000) &&
        isValidOptionalStringOrNull('sensory_notes', 1000) &&
        isValidOptionalList('benefits', 30) &&
        isValidOptionalStringOrNull('image', 2000) &&
        isValidOptionalStringOrNull('image_url', 2000) &&
        isValidOptionalNonNegativeNumber('stock_quantity') &&
        isValidOptionalNonNegativeNumber('weight_grams') &&
        isValidOptionalNonNegativeNumber('package_width_cm') &&
        isValidOptionalNonNegativeNumber('package_height_cm') &&
        isValidOptionalNonNegativeNumber('package_depth_cm') &&
        isValidOptionalTimestamp('createdAt') &&
        isValidOptionalTimestamp('updatedAt');
    }

    function isValidCategory(data) {
      let allowedFields = ['id', 'label', 'createdAt', 'updatedAt'];
      return hasRequiredFields(['id', 'label']) &&
        hasOnlyAllowedFields(allowedFields) &&
        validStringLength('id', 1, 100) &&
        validStringLength('label', 1, 100) &&
        isValidOptionalTimestamp('createdAt') &&
        isValidOptionalTimestamp('updatedAt');
    }

    // ===============================================================
    // Collection Rules
    // ===============================================================

    // Public catalog products: anyone can read; authenticated admins can write
    match /products/{productId} {
      allow read: if true;
      allow create: if isAuthenticated() && isValidProduct(request.resource.data);
      allow update: if isAuthenticated() && isValidProduct(request.resource.data) && immutableCreatedAtUnchanged();
      allow delete: if isAuthenticated();
    }

    // Public catalog categories: anyone can read; authenticated admins can write
    match /categories/{categoryId} {
      allow read: if true;
      allow create: if isAuthenticated() && isValidCategory(request.resource.data);
      allow update: if isAuthenticated() && isValidCategory(request.resource.data) && immutableCreatedAtUnchanged();
      allow delete: if isAuthenticated();
    }

    // Default deny all other paths
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
